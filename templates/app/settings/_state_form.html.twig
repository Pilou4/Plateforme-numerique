{#
    Formulaire d'un statut de projet, affiché dans la modal (page Paramètres).
    - mode    : 'add' (ajout) ou 'edit' (modification : le JavaScript pré-remplit les champs et l'adresse de l'API)
    - api_url : adresse de l'API en ajout
    - colors  : les couleurs possibles (App\Enum\ProjectStateColor)
#}
<form class="project-form" data-settings-form="state" data-mode="{{ mode }}" data-api-url="{{ api_url }}" novalidate>
    <div class="project-form__fields">
        <label class="project-form__field">
            <span class="project-form__label">Nom <span class="project-form__required" aria-hidden="true">*</span></span>
            <input type="text" name="label" class="project-form__input" maxlength="50" placeholder="Ex. : En pause" required autofocus>
        </label>

        <label class="project-form__field">
            <span class="project-form__label">Nom au pluriel <span class="project-form__optional">(facultatif)</span></span>
            <input type="text" name="pluralLabel" class="project-form__input" maxlength="50" placeholder="Ex. : En pause">
            <span class="project-form__help">Pour les filtres de la liste des projets (« Terminés »). Vide : le même que le nom.</span>
        </label>

        {# Couleur : chaque choix montre la pastille telle qu'elle apparaîtra sur la carte d'un projet #}
        <fieldset class="project-form__field settings-colors">
            <legend class="project-form__label">Couleur</legend>
            <div class="settings-colors__list">
                {% for color in colors %}
                    <label class="settings-colors__choice">
                        <input type="radio" name="color" value="{{ color.value }}" class="settings-colors__input" {{ loop.first ? 'checked' }}>
                        <span class="settings-colors__pill project-state--{{ color.cssModifier }}">
                            <span class="settings-list__state-dot" aria-hidden="true"></span>
                            {{ color.label }}
                        </span>
                    </label>
                {% endfor %}
            </div>
        </fieldset>
    </div>
    <p class="project-form__error" data-form-error role="alert"></p>
    <div class="modal__actions">
        <button type="button" class="projects__button projects__button--ghost" data-modal-close>Annuler</button>
        <button type="submit" class="projects__button">{{ mode == 'add' ? 'Ajouter' : 'Enregistrer' }}</button>
    </div>
</form>
