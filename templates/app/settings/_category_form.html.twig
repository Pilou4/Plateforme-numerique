{#
    Formulaire d'une catégorie de projet, affiché dans la modal (page Paramètres).
    - mode    : 'add' (ajout) ou 'edit' (modification : le JavaScript pré-remplit le nom et l'adresse de l'API)
    - api_url : adresse de l'API en ajout
#}
<form class="project-form" data-settings-form="category" data-mode="{{ mode }}" data-api-url="{{ api_url }}" novalidate>
    <div class="project-form__fields">
        <label class="project-form__field">
            <span class="project-form__label">Nom <span class="project-form__required" aria-hidden="true">*</span></span>
            <input type="text" name="name" class="project-form__input" maxlength="100" placeholder="Ex. : Application mobile" required autofocus>
        </label>
    </div>
    <p class="project-form__error" data-form-error role="alert"></p>
    <div class="modal__actions">
        <button type="button" class="projects__button projects__button--ghost" data-modal-close>Annuler</button>
        <button type="submit" class="projects__button">{{ mode == 'add' ? 'Ajouter' : 'Enregistrer' }}</button>
    </div>
</form>
