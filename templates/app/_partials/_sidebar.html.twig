{% set current_route = app.current_route %}

{# Pages du sous-menu Documentation #}
{% set documentation_submenu_routes = ['app_documentation_glossary'] %}
{% set is_in_documentation_submenu = current_route in documentation_submenu_routes %}

{#
    Mobile et tablette (900px et moins) : le menu est un tiroir, ouvert par le bouton « burger »
    de la nav du haut et fermé par la croix, le fond sombre, la touche Échap ou un lien (MobileMenu.js).

    Grand écran, menu replié (SidebarToggle.js) : seules les icônes restent visibles ;
    le libellé (.app-sidebar__label) s'affiche dans une infobulle au survol (SidebarTooltip.js).

    Règle du menu :
    - chaque lien principal a une icône SVG (public/images/icones/) ;
    - le bouton flèche et le bloc .app-sidebar__submenu ne sont ajoutés
      QUE sur un lien principal qui a un sous-menu ;
    - les sous-menus sont fermés au chargement de la page, sauf si la page
      en cours fait partie du sous-menu (il est alors ouvert).
#}

<aside class="app-sidebar" id="app-sidebar">
    <div class="app-sidebar__inner">
        {# Replie ou déplie le menu (assets/js/app/SidebarToggle.js) #}
        <button type="button" class="app-sidebar__toggle" data-sidebar-toggle aria-controls="app-sidebar-nav" aria-expanded="true" aria-label="Fermer le menu">
            <img src="{{ asset('images/icones/menu-light.svg') }}" alt="" class="app-sidebar__toggle-icon app-sidebar__toggle-icon--open" width="18" height="18">
            <img src="{{ asset('images/icones/chevron-right-light.svg') }}" alt="" class="app-sidebar__toggle-icon app-sidebar__toggle-icon--closed" width="18" height="18">
        </button>

        {# Mobile et tablette : le menu est un tiroir, ce bouton le ferme (assets/js/app/MobileMenu.js) #}
        <button type="button" class="app-sidebar__close" data-app-menu-close aria-label="Fermer le menu">
            <img src="{{ asset('images/icones/close.svg') }}" alt="" width="20" height="20">
        </button>

        <nav class="app-sidebar__nav" id="app-sidebar-nav" aria-label="Menu de l'application">
            <ul class="app-sidebar__list">
                {# Lien principal sans sous-menu : Projet (actif sur la liste, le détail et les tâches d'un projet) #}
                <li class="app-sidebar__item">
                    <div class="app-sidebar__row">
                        <a href="{{ path('app_project') }}" class="app-sidebar__link" {% if current_route starts with 'app_project' %}aria-current="page"{% endif %}>
                            <img src="{{ asset('images/icones/project.svg') }}" alt="" class="app-sidebar__icon" width="18" height="18">
                            <span class="app-sidebar__label">Projet</span>
                        </a>
                    </div>
                </li>

                {# Lien principal avec sous-menu : Documentation (la page d'un tutoriel garde ce lien actif) #}
                <li class="app-sidebar__item{% if is_in_documentation_submenu %} app-sidebar__item--open app-sidebar__item--current{% endif %}">
                    <div class="app-sidebar__row">
                        <a href="{{ path('app_documentation') }}" class="app-sidebar__link" {% if current_route in ['app_documentation', 'app_documentation_show'] %}aria-current="page"{% endif %}>
                            <img src="{{ asset('images/icones/documentation.svg') }}" alt="" class="app-sidebar__icon" width="18" height="18">
                            <span class="app-sidebar__label">Documentation</span>
                        </a>
                        <button type="button" class="app-sidebar__submenu-toggle" aria-controls="submenu-documentation" aria-expanded="{{ is_in_documentation_submenu ? 'true' : 'false' }}" aria-label="Afficher le sous-menu Documentation">
                            <img src="{{ asset('images/icones/chevron-down.svg') }}" alt="" class="app-sidebar__submenu-icon" width="16" height="16">
                        </button>
                    </div>

                    <div class="app-sidebar__submenu" id="submenu-documentation">
                        <ul class="app-sidebar__submenu-list">
                            <li class="app-sidebar__submenu-item">
                                <a href="{{ path('app_documentation_glossary') }}" class="app-sidebar__submenu-link" {% if current_route == 'app_documentation_glossary' %}aria-current="page"{% endif %}>Glossaire</a>
                            </li>
                        </ul>
                    </div>
                </li>

                {# Lien principal sans sous-menu : Éléments (catalogue des styles de l'app) #}
                <li class="app-sidebar__item">
                    <div class="app-sidebar__row">
                        <a href="{{ path('app_elements') }}" class="app-sidebar__link" {% if current_route == 'app_elements' %}aria-current="page"{% endif %}>
                            <img src="{{ asset('images/icones/elements.svg') }}" alt="" class="app-sidebar__icon" width="18" height="18">
                            <span class="app-sidebar__label">Éléments</span>
                        </a>
                    </div>
                </li>

                {# Lien principal sans sous-menu : Paramètres (catégories et statuts des projets) #}
                <li class="app-sidebar__item">
                    <div class="app-sidebar__row">
                        <a href="{{ path('app_settings') }}" class="app-sidebar__link" {% if current_route == 'app_settings' %}aria-current="page"{% endif %}>
                            <img src="{{ asset('images/icones/settings.svg') }}" alt="" class="app-sidebar__icon" width="18" height="18">
                            <span class="app-sidebar__label">Paramètres</span>
                        </a>
                    </div>
                </li>
            </ul>
        </nav>
    </div>
</aside>
