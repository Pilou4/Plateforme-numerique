{% extends 'app/base.html.twig' %}

{% block title %}Éléments{% endblock %}

{# JavaScript de l'app + celui de cette page (aperçu des icônes dans la modal) #}
{% block importmap %}{{ importmap(['app', 'app-space', 'app-elements']) }}{% endblock %}

{#
    Catalogue des styles de base de l'app, pour voir le rendu de chaque élément.
    Une section par élément ; à compléter au fur et à mesure.
#}
{% block app_body %}
<main id="elements">
    {#
        Démonstration de l'en-tête complet : bouton « + » (ouvre une modal d'exemple), recherche,
        filtres et onglets. Ici, la recherche et les filtres ne filtrent rien.
    #}
    {% set demo_tab = app.request.query.get('onglet', '1') %}
    {{ include('app/_partials/_page_header.html.twig', {
        title: 'Éléments',
        eyebrow: 'Interface',
        count: 3,
        lead: 'Les éléments de base de l\'app et leur rendu.',
        search: 'Rechercher…',
        actions: [
            {label: 'Exemple d\'action', icon: 'plus.svg', modal: 'elements-demo-modal', modal_title: 'Exemple de modal', modal_size: 'small',
             attributes: {'data-modal-icon': asset('images/icones/elements.svg')}},
            {label: 'Action secondaire', icon: 'edit-light.svg', variant: 'ghost', modal: 'elements-demo-modal', modal_title: 'Exemple de modal', modal_size: 'small'},
        ],
        filters: [
            {name: 'demo-state', label: 'Statut', icon: 'filter-status.svg', color: 'blue', options: [
                {value: '', label: 'Tous les statuts'},
                {value: 'pas_commence', label: 'Pas commencés', color: 'violet'},
                {value: 'en_cours', label: 'En cours', color: 'blue'},
                {value: 'termine', label: 'Terminés', color: 'green'},
                {value: 'en_pause', label: 'En pause', color: 'orange'},
            ]},
            {name: 'demo-category', label: 'Catégorie', icon: 'filter-category.svg', color: 'green', options: [
                {value: '', label: 'Toutes les catégories'},
                {value: 'web', label: 'Application web'},
                {value: 'outils', label: 'Outils de gestion interne de l\'entreprise'},
            ]},
            {name: 'demo-favorite', label: 'Favoris', icon: 'filter-favorite.svg', color: 'yellow', options: [
                {value: '', label: 'Tous'},
                {value: 'oui', label: 'Favoris seulement'},
            ]},
        ],
        tabs_label: 'Onglets de démonstration',
        tabs: [
            {label: 'Onglet 1', url: path('app_elements'), count: 12, active: demo_tab == '1'},
            {label: 'Onglet 2', url: path('app_elements', {onglet: 2}), count: 4, active: demo_tab == '2'},
            {label: 'Onglet 3', url: path('app_elements', {onglet: 3}), active: demo_tab == '3'},
        ],
    }, with_context = false) }}

    {# Contenu de la modal ouverte par les boutons de l'en-tête de démonstration #}
    <template id="elements-demo-modal">
        <p class="elements__section-text">Exemple de modal : en-tête bleu, contenu, puis les boutons séparés par le trait bleu.</p>
        <div class="modal__actions">
            <button type="button" class="projects__button projects__button--ghost" data-modal-close>Annuler</button>
            <button type="button" class="projects__button" data-modal-close>Valider</button>
        </div>
    </template>

    <div class="elements" data-elements>
        {# --- Bandeaux de message (composant notice) --- #}
        <section class="elements__section" aria-labelledby="elements-notices-title">
            <h2 class="elements__section-title" id="elements-notices-title">Bandeaux de message</h2>
            <p class="elements__section-text">
                JavaScript : <code class="elements__code">showNotice('success', 'Message')</code>
                · PHP : <code class="elements__code">$this->addFlash('success', 'Message')</code>
            </p>

            <div class="elements__notices">
                {% for type, message in notice_types %}
                    <div class="elements__notice-example">
                        <p class="elements__label">{{ type }}</p>
                        {# Même HTML que _partials/_notices.html.twig, affiché dans la page (et non en haut de l'écran) #}
                        <div class="notice notice--{{ type }}">
                            <img src="{{ asset('images/icones/notice-' ~ type ~ '.svg') }}" alt="" class="notice__icon" width="20" height="20">
                            <p class="notice__text">{{ message }}</p>
                            <button type="button" class="notice__close" aria-label="Fermer le message" disabled>
                                <img src="{{ asset('images/icones/close.svg') }}" alt="" width="16" height="16">
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>

        {#
            --- Tableau : les styles des tableaux des sections (App\Enum\ProjectSectionTableStyle) ---
            Même HTML que templates/app/project/_section_block.html.twig ; la liste change la classe du style
            (TableStyleDemo.js). Clic sur un en-tête avec flèches : tri (TableSorter.js) ; « Rôle » n'est pas triable.
        #}
        {% set table_styles = enum_cases('App\\Enum\\ProjectSectionTableStyle') %}
        {% set demo_columns = [
            {label: 'Table', sortable: true},
            {label: 'Rôle', sortable: false},
            {label: 'Lignes', sortable: true},
            {label: 'Liée à', sortable: true},
        ] %}
        {% set demo_rows = [
            ['`project`', 'Un projet : nom, logo, statut', '12', '—'],
            ['`project_section`', 'Les sections de la présentation', '48', '`project`'],
            ['`project_step`', 'Les tâches et sous-tâches', '135', '`project`'],
            ['`project_file`', 'Les fichiers envoyés', '27', '`project`'],
            ['`project_category`', 'Les catégories', '6', '—'],
        ] %}
        <section class="elements__section" aria-labelledby="elements-table-title">
            <h2 class="elements__section-title" id="elements-table-title">
                Tableau <span class="elements__count">{{ table_styles|length }} styles</span>
            </h2>
            <p class="elements__section-text">
                Bloc Tableau des sections d'un projet : le style se choisit dans l'éditeur.
                Clique sur un en-tête avec des flèches pour trier (croissant, puis décroissant).
            </p>

            <div class="elements__field">
                <label class="elements__field-label" for="elements-table-style">Style</label>
                <select class="elements__select" id="elements-table-style" data-table-style-select>
                    {% for style in table_styles %}
                        <option value="{{ style.cssModifier }}">{{ style.label }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="section-block__table-wrap section-block__table-wrap--{{ (table_styles|first).cssModifier }}" data-table-style-target>
                <table class="section-block__table" data-table-sort>
                    <thead class="section-block__table-header">
                        <tr>
                            {% for column in demo_columns %}
                                {% if column.sortable %}
                                    <th scope="col" class="section-block__table-head" aria-sort="none" data-sortable>
                                        <button type="button" class="table-sort">{{ column.label }}<span class="table-sort__icon" aria-hidden="true"><span class="table-sort__up"></span><span class="table-sort__down"></span></span></button>
                                    </th>
                                {% else %}
                                    <th scope="col" class="section-block__table-head">{{ column.label }}</th>
                                {% endif %}
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in demo_rows %}
                            <tr class="section-block__table-row">
                                {% for text in row %}
                                    <td class="section-block__table-cell">
                                        {%- if loop.first -%}
                                            <span class="section-block__table-label">{{ text|inline_format }}</span>
                                        {%- else -%}
                                            {{ text|inline_format }}
                                        {%- endif -%}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        {# --- Tags : les couleurs des tags des sections (App\Enum\ProjectSectionTagColor), même HTML que _section_block.html.twig --- #}
        {% set tag_colors = enum_cases('App\\Enum\\ProjectSectionTagColor') %}
        <section class="elements__section" aria-labelledby="elements-tags-title">
            <h2 class="elements__section-title" id="elements-tags-title">
                Tags <span class="elements__count">{{ tag_colors|length }} couleurs</span>
            </h2>
            <p class="elements__section-text">
                Bloc Tags des sections d'un projet : la couleur se choisit tag par tag dans l'éditeur (petit rond du tag).
            </p>

            <ul class="section-block__tags">
                {% for color in tag_colors %}
                    <li class="section-block__tag section-block__tag--{{ color.cssModifier }}">{{ color.label }}</li>
                {% endfor %}
            </ul>
        </section>

        {# --- Icônes : tout le dossier public/images/icones --- #}
        <section class="elements__section" aria-labelledby="elements-icons-title">
            <h2 class="elements__section-title" id="elements-icons-title">
                Icônes <span class="elements__count">{{ icons|length }}</span>
            </h2>
            <p class="elements__section-text">
                Dossier <code class="elements__code">public/images/icones/</code> : une nouvelle icône apparaît ici automatiquement.
                Clique sur une icône pour la voir en grand.
            </p>

            <ul class="elements__icons">
                {% for icon in icons %}
                    <li class="elements__icon-item">
                        <button type="button" class="elements__icon" data-icon-preview data-icon-name="{{ icon }}" data-icon-url="{{ asset('images/icones/' ~ icon) }}">
                            <span class="elements__icon-preview">
                                <img src="{{ asset('images/icones/' ~ icon) }}" alt="" class="elements__icon-image">
                            </span>
                            <span class="elements__icon-name" title="{{ icon }}">{{ icon }}</span>
                        </button>
                    </li>
                {% endfor %}
            </ul>
        </section>

        {# Contenu de la modal d'aperçu d'une icône, rempli par le JavaScript #}
        <template data-icon-viewer>
            <div class="icon-viewer">
                <div class="icon-viewer__sizes">
                    <figure class="icon-viewer__size">
                        <span class="icon-viewer__stage icon-viewer__stage--large">
                            <img src="" alt="" class="icon-viewer__image icon-viewer__image--large" data-icon-image>
                        </span>
                        <figcaption class="icon-viewer__caption">En grand</figcaption>
                    </figure>
                    <figure class="icon-viewer__size">
                        <span class="icon-viewer__stage icon-viewer__stage--dark">
                            <img src="" alt="" class="icon-viewer__image icon-viewer__image--large" data-icon-image>
                        </span>
                        <figcaption class="icon-viewer__caption">Sur fond sombre</figcaption>
                    </figure>
                    <figure class="icon-viewer__size">
                        <span class="icon-viewer__stage">
                            <img src="" alt="" class="icon-viewer__image" data-icon-image data-icon-natural>
                        </span>
                        <figcaption class="icon-viewer__caption" data-icon-natural-caption>Taille réelle</figcaption>
                    </figure>
                </div>
                <div class="icon-viewer__footer">
                    <p class="icon-viewer__path">
                        <code class="elements__code" data-icon-path></code>
                    </p>
                    {# href et nom du fichier remplis par IconViewer.js ; download : le navigateur enregistre le fichier au lieu de l'ouvrir #}
                    <a href="" download="" class="icon-viewer__download" data-icon-download>
                        <img src="{{ asset('images/icones/download.svg') }}" alt="" width="16" height="16">
                        <span>Télécharger l'icône</span>
                    </a>
                </div>
            </div>
        </template>
    </div>
</main>
{% endblock %}
