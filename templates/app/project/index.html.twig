{% extends 'app/base.html.twig' %}

{% block title %}Projets{% endblock %}

{# JavaScript de l'app + celui de cette page uniquement #}
{% block importmap %}{{ importmap(['app', 'app-space', 'app-projects']) }}{% endblock %}

{% block app_body %}
<main id="projects">
    {{ include('app/_partials/_page_header.html.twig', {
        title: 'Mes projets',
        count: projects|length,
        lead: 'Chaque projet a sa présentation, ses tâches et ses fichiers.',
        actions: [
            {label: 'Ajouter un projet', icon: 'plus.svg', modal: 'project-create', modal_title: 'Nouveau projet', modal_size: 'medium'},
        ],
    }, with_context = false) }}

    <div class="projects">
        {% if projects is empty %}
            <p class="projects__empty">Aucun projet pour l'instant.</p>
        {% else %}
            <ul class="projects__list">
                {% for project in projects %}
                    <li class="projects__item">
                        <article class="project-card">
                            <div class="project-card__header">
                                {% if project.logo %}
                                    <img src="{{ path('app_project_logo', {slug: project.slug}) }}" alt="" class="project-card__logo" width="48" height="48">
                                {% else %}
                                    {# Sans logo : initiale du projet #}
                                    <span class="project-card__logo project-card__logo--initial" aria-hidden="true">{{ project.name|first|upper }}</span>
                                {% endif %}
                                <h2 class="project-card__title">{{ project.name }}</h2>
                                <button type="button" class="project-card__edit"
                                        data-modal-open="project-edit-{{ project.id }}"
                                        data-modal-title="Modifier le projet"
                                        aria-label="Modifier le projet « {{ project.name }} »">
                                    <img src="{{ asset('images/icones/edit.svg') }}" alt="" width="16" height="16">
                                </button>
                            </div>
                            {% if project.summary %}
                                <p class="project-card__summary">{{ project.summary }}</p>
                            {% endif %}
                            <div class="project-card__links">
                                <a href="{{ path('app_project_show', {slug: project.slug}) }}" class="project-card__link">
                                    Voir le projet
                                </a>
                                <a href="{{ path('app_project_steps', {slug: project.slug}) }}" class="project-card__link project-card__link--primary">
                                    Voir les tâches
                                </a>
                            </div>
                        </article>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {# Formulaire d'ajout, affiché dans la modal (bouton « Ajouter un projet ») #}
        <template id="project-create">
            {{ include('app/project/_project_form.html.twig') }}
        </template>

        {# Formulaires de modification, un par projet (bouton crayon de chaque carte) #}
        {% for project in projects %}
            <template id="project-edit-{{ project.id }}">
                {{ include('app/project/_project_form.html.twig', {project: project}) }}
            </template>
        {% endfor %}
    </div>
</main>
{% endblock %}
