{% extends 'app/base.html.twig' %}

{% block title %}{{ project.name }} · Projet{% endblock %}

{# JavaScript de l'app + celui des projets (formulaire du projet, éditeur des sections) #}
{% block importmap %}{{ importmap(['app', 'app-space', 'app-projects']) }}{% endblock %}

{#
    sections_editor_data : contenu de chaque section pour l'éditeur de blocs, par id de section
    (App\Service\ProjectSectionEditorData)
#}
{% block app_body %}
<main id="project">
    {{ include('app/project/_project_header.html.twig', {
        project: project,
        active: 'show',
        lead: project.summary,
        actions: [
            {label: 'Ajouter une section', icon: 'plus.svg', attributes: {'data-section-add': ''}},
            {label: 'Modifier le projet', icon: 'edit-light.svg', modal: 'project-edit', modal_title: 'Modifier le projet', variant: 'ghost',
             attributes: {'data-modal-icon': asset('images/icones/project.svg')}},
        ],
    }, with_context = false) }}

    {# Éditeur des sections : assets/js/app/project/sections/ProjectSections.js #}
    <article class="project"
             data-project-sections
             data-api-url="{{ path('api_project_sections_create', {slug: project.slug}) }}"
             data-files-url="{{ path('api_project_files_list', {slug: project.slug}) }}">
        {% for section in project.sections %}
            <section class="project__section section-editable" id="section-{{ section.id }}" aria-labelledby="project-section-{{ section.id }}"
                     data-section
                     data-section-id="{{ section.id }}"
                     data-section-title="{{ section.title }}"
                     data-section-data="{{ sections_editor_data[section.id]|json_encode }}">
                {{ include('app/_partials/_section_tools.html.twig', {section: section, is_first: loop.first, is_last: loop.last}, with_context = false) }}
                <h2 class="project__heading" id="project-section-{{ section.id }}">{{ section.title }}</h2>
                <div class="section-blocks">
                    {% for block in section.blocks %}
                        {{ include('app/project/_section_block.html.twig', {block: block, project: project}, with_context = false) }}
                    {% else %}
                        <p class="section-blocks__empty">Cette section est vide : clique sur le crayon pour lui ajouter des blocs.</p>
                    {% endfor %}
                </div>
            </section>
        {% else %}
            <p class="project__empty" data-sections-empty>Ce projet n'a pas encore de présentation : ajoute une première section avec le bouton « Ajouter une section ».</p>
        {% endfor %}

        {# L'éditeur d'une nouvelle section s'ouvre ici, à la fin de la présentation #}
        <div data-new-section-slot></div>

        {{ include('app/project/_section_editor.html.twig', {}, with_context = false) }}
    </article>

    {# Formulaire de modification, affiché dans la modal (bouton « Modifier le projet ») #}
    <template id="project-edit">
        {{ include('app/project/_project_form.html.twig', {project: project, redirect_to_project: true}) }}
    </template>
</main>
{% endblock %}
