{% extends 'app/base.html.twig' %}

{% block title %}Documentation{% endblock %}

{# JavaScript de l'app + celui de la documentation (ajout d'un tutoriel) #}
{% block importmap %}{{ importmap(['app', 'app-space', 'app-documentation']) }}{% endblock %}

{% block app_body %}
<main id="documentation">
    {{ include('app/documentation/_documentation_header.html.twig', {
        title: 'Tutoriels',
        active: 'tutorials',
        lead: 'Les notions et outils appris au fil du projet, expliqués étape par étape.',
        actions: [
            {label: 'Ajouter un tutoriel', icon: 'plus.svg', modal: 'topic-add', modal_title: 'Nouveau tutoriel', modal_size: 'medium'},
        ],
        topic_count: topics|length,
        term_count: term_count,
    }, with_context = false) }}

    <article class="doc-page">
        {% if topics is empty %}
            <p class="doc-page__empty">Aucun tutoriel pour l'instant.</p>
        {% else %}
            <ul class="doc-topics">
                {% for topic in topics %}
                    <li class="doc-topics__item">
                        <a href="{{ path('app_documentation_show', {slug: topic.slug}) }}" class="doc-topics__link">
                            <h2 class="doc-topics__title">{{ topic.title }}</h2>
                            {% if topic.summary %}
                                <p class="doc-topics__summary">{{ topic.summary }}</p>
                            {% endif %}
                            <p class="doc-topics__meta">
                                {{ topic.sections|length }} section{{ topic.sections|length > 1 ? 's' }}
                            </p>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {# Formulaire d'ajout d'un tutoriel (modal) #}
        <template id="topic-add">
            {{ include('app/documentation/_topic_form.html.twig', {}, with_context = false) }}
        </template>
    </article>
</main>
{% endblock %}
