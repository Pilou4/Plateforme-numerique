{% extends 'base.html.twig' %}

{% block title %}Plateforme Numérique · IA, automatisation et outils numériques{% endblock %}

{% block metaTag %}
    <meta name="description" content="Développement, automatisation, intelligence artificielle, cybersécurité et formation pour les particuliers, indépendants et PME.">
{% endblock %}

{% block url %}
    <link rel="canonical" href="{{ url('home') }}">
{% endblock %}

{# contact_form : formulaire de contact, envoyé par HomeController #}

{% set domains = [
    {title: 'Intelligence artificielle', icon: 'service-ia.svg', text: 'Assistants IA, automatisation, analyse documentaire et intégration de solutions d\'intelligence artificielle.'},
    {title: 'Développement', icon: 'service-web.svg', text: 'Applications web, outils métier et solutions numériques sur mesure.'},
    {title: 'Cybersécurité', icon: 'service-securite.svg', text: 'Sensibilisation, bonnes pratiques et accompagnement pour améliorer la sécurité numérique.'},
    {title: 'Formation', icon: 'service-formation.svg', text: 'Formation et accompagnement pour particuliers, étudiants et professionnels.'},
] %}

{% set technologies = ['Symfony 8', 'PHP', 'Docker', 'MySQL', 'Git', 'PHPUnit', 'JavaScript', 'IA'] %}

{% block body %}
<main id="home">
    {# --- 1. Accroche --- #}
    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero__inner">
            <div class="home-hero__text">
                <h1 class="home-hero__title" id="home-title">
                    Transformez votre activité grâce à l'IA, l'automatisation et des outils numériques adaptés.
                </h1>
                <p class="home-hero__lead">
                    Développement, automatisation, cybersécurité et formation pour les particuliers, indépendants et PME.
                </p>
                <div class="home-hero__actions">
                    <a href="#projet" class="home-button home-button--primary">Découvrir le projet</a>
                    <a href="#contact" class="home-button home-button--secondary">Me contacter</a>
                </div>
            </div>

            {# Illustration décorative : une fenêtre de code stylisée #}
            <div class="home-hero__visual" aria-hidden="true">
                <div class="home-hero__card home-hero__card--back"></div>
                <div class="home-hero__card home-hero__card--front">
                    <span class="home-hero__dots">
                        <span class="home-hero__dot"></span>
                        <span class="home-hero__dot"></span>
                        <span class="home-hero__dot"></span>
                    </span>
                    <span class="home-hero__line home-hero__line--long"></span>
                    <span class="home-hero__line home-hero__line--medium"></span>
                    <span class="home-hero__line home-hero__line--short"></span>
                    <span class="home-hero__line home-hero__line--long"></span>
                    <span class="home-hero__badge">Symfony · Docker · IA</span>
                </div>
            </div>
        </div>
    </section>

    {# --- 2. Pourquoi ce projet ? --- #}
    <section class="home-section" id="projet" aria-labelledby="home-why-title">
        <div class="home-section__inner">
            <h2 class="home-section__title" id="home-why-title">Pourquoi ce projet existe ?</h2>
            <div class="home-text">
                <p class="home-text__paragraph">L'intelligence artificielle et les outils numériques évoluent rapidement.</p>
                <p class="home-text__paragraph">Pourtant, beaucoup de particuliers et d'entreprises ne savent pas toujours comment les utiliser concrètement.</p>
                <p class="home-text__paragraph home-text__paragraph--strong">L'objectif de Plateforme Numérique est de proposer des solutions simples, utiles et adaptées aux besoins réels.</p>
                <p class="home-text__paragraph">
                    Les prestations sont réalisées majoritairement à distance, ce qui permet d'accompagner efficacement
                    des particuliers et des entreprises sur l'ensemble du territoire. Lorsque cela est pertinent,
                    des interventions sur site peuvent également être organisées.
                </p>
            </div>
        </div>
    </section>

    {# --- 3. Domaines d'expertise --- #}
    <section class="home-section home-section--alt" id="domaines" aria-labelledby="home-domains-title">
        <div class="home-section__inner">
            <h2 class="home-section__title" id="home-domains-title">Domaines d'expertise</h2>
            <ul class="home-domains">
                {% for domain in domains %}
                    <li class="home-domain">
                        <span class="home-domain__icon">
                            <img src="{{ asset('images/icones/' ~ domain.icon) }}" alt="" width="24" height="24">
                        </span>
                        <h3 class="home-domain__title">{{ domain.title }}</h3>
                        <p class="home-domain__text">{{ domain.text }}</p>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>

    {# --- 4. La plateforme en construction --- #}
    <section class="home-section" id="plateforme" aria-labelledby="home-platform-title">
        <div class="home-section__inner home-platform">
            <div class="home-platform__text">
                <h2 class="home-section__title" id="home-platform-title">Une plateforme qui évolue avec les compétences</h2>
                <div class="home-text">
                    <p class="home-text__paragraph">Cette plateforme est également un laboratoire technique et un support d'apprentissage.</p>
                    <p class="home-text__paragraph">Chaque nouvelle compétence acquise peut être expérimentée et intégrée au projet lorsque cela est pertinent.</p>
                </div>
                {# Pointe vers le suivi du projet dans l'app #}
                <a href="{{ path('app_project_show', {slug: 'plateforme-numerique'}) }}" class="home-button home-button--secondary home-platform__button">Suivre l'avancement</a>
            </div>
            <div class="home-platform__technologies">
                <h3 class="home-platform__subtitle">Technologies utilisées</h3>
                <ul class="service-tags">
                    {% for technology in technologies %}
                        <li class="service-tags__item">{{ technology }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </section>

    {# --- 5. Vision --- #}
    <section class="home-section home-section--alt" id="vision" aria-labelledby="home-vision-title">
        <div class="home-section__inner">
            <h2 class="home-section__title" id="home-vision-title">Une vision à long terme</h2>
            <div class="home-text">
                <p class="home-text__paragraph">Construire une entreprise capable d'accompagner les particuliers et les professionnels dans leur transition numérique.</p>
                <ul class="service-examples home-vision__list">
                    <li class="service-examples__item">Créer des solutions utiles.</li>
                    <li class="service-examples__item">Transmettre les connaissances.</li>
                    <li class="service-examples__item">Sensibiliser aux risques numériques.</li>
                </ul>
                <p class="home-text__paragraph">Et progressivement développer des outils et services permettant de simplifier le quotidien grâce au numérique.</p>
            </div>
        </div>
    </section>

    {# --- 6. Contact --- #}
    <section class="home-section" id="contact" aria-labelledby="home-contact-title">
        <div class="home-section__inner home-contact">
            <div class="home-contact__intro">
                <h2 class="home-section__title" id="home-contact-title">Parlons de votre projet</h2>
                <p class="home-contact__text">
                    Vous avez un projet, une question ou souhaitez simplement échanger sur une solution numérique,
                    une automatisation ou l'intelligence artificielle ?
                </p>
                <p class="home-contact__text">N'hésitez pas à me contacter.</p>

                {{ include('home/_contact_infos.html.twig', {}, with_context = false) }}
            </div>

            {{ include('home/_contact_form.html.twig', {form: contact_form}, with_context = false) }}
        </div>
    </section>
</main>
{% endblock %}
